# Mental Health Chatbot Environment Variables
# Copy this file to .env and fill in your values

# API Keys
GEMINI_API_KEY=your_gemini_api_key_here
HF_TOKEN=your_huggingface_token_here

# Database Configuration
DATABASE_URL=sqlite:///chatbot.db
# For production, use PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost/chatbot

# Application Settings
DEBUG=false
LOG_LEVEL=INFO

# Emergency Handler Settings
HOTLINE_NUMBER=0984.104.115
HOTLINE_START_TIME=07:30
HOTLINE_END_TIME=22:00

# Model Paths
SENTIMENT_MODEL_PATH=models/weights/sentiment
MENTAL_STATE_MODEL_PATH=models/weights/mental_state
GATING_ROUTER_MODEL_PATH=models/weights/gating_router

# Server Configuration
HOST=0.0.0.0
PORT=8000
FRONTEND_PORT=7860

# Security
SECRET_KEY=your_secret_key_here
CORS_ORIGINS=["http://localhost:3000", "http://localhost:7860"]

# Logging
LOG_FILE=logs/chatbot.log
LOG_MAX_SIZE=10MB
LOG_BACKUP_COUNT=5 